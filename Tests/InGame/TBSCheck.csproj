<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration>Release</Configuration><Platform>AnyCPU</Platform><OutputType>Library</OutputType>
    <AssemblyName>TBSCheck</AssemblyName><TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion><LangVersion>latest</LangVersion>
    <KspDir Condition=" '$(KspDir)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KspDir>
    <KspManaged>$(KspDir)\KSP_x64_Data\Managed</KspManaged>
    <DebugType>none</DebugType><Optimize>true</Optimize><OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="Assembly-CSharp"><HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KspManaged)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(KspManaged)\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(KspManaged)\UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(KspManaged)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PhilsToolbarSorter"><HintPath>..\..\bin\Release\PhilsToolbarSorter.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup><Compile Include="TBSCheck.cs" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
